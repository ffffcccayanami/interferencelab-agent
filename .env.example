# ---------------------------------------------------------------------------
# 该文件只是占位符模板，可以安全提交。
# 使用方式（二选一，前者优先）：
#   cp .env.example backend/.env
#   cp .env.example .env            # 仓库根目录同样会被读取
# 两个文件都已被 .gitignore 忽略；重新生成模板：
#   python scripts/env_template.py --write
# ---------------------------------------------------------------------------

# LLM（OpenAI 兼容接口；只允许后端访问，浏览器永远拿不到这里的凭据）
LLM_ENABLED=true
# 部署预设（可选）：deepseek / openai / qwen / vllm / ollama / lmstudio / anthropic / gemini
# 填了预设后，base_url / auth_mode / health_path / 默认模型会自动补齐；显式变量仍然优先
LLM_PROFILE=
# 传输层：auto（由预设推导）/ openai（OpenAI 兼容）/ anthropic / gemini
LLM_PROVIDER=auto
# 仅用于展示：auto 时按 base_url 推导（127.0.0.1 → local，https → cloud）
LLM_DEPLOYMENT=auto
LLM_MODEL_ID=YOUR_LLM_MODEL_ID
# 云端 HTTPS 端点示例： https://your-gateway.example.com/v1
# SSH 隧道端点示例：    http://127.0.0.1:8000/v1
LLM_BASE_URL=
LLM_API_KEY=YOUR_LLM_API_KEY
# auto：按预设决定；bearer / none / x-api-key / query
LLM_AUTH_MODE=auto
LLM_TIMEOUT=120
# 连通性探测：GET <LLM_BASE_URL><LLM_HEALTH_PATH>，默认 /models，不消耗 token
LLM_HEALTH_PATH=/models
LLM_HEALTH_TIMEOUT=5
# 推理模型（deepseek-flash / R1 类）的思考 token 也计入 max_tokens，输出上限要留余量
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CALLS_PER_RUN=8
LLM_MAX_PROMPT_CHARS=24000
# 流式观测：TTFT 依赖流式；网关不支持时自动降级为无 usage 流式 / 非流式
LLM_STREAMING=true
LLM_STREAM_INCLUDE_USAGE=true
# 可选：vLLM 类端点的 Prometheus 指标（建议只在隧道内配置，勿对公网开放）
LLM_METRICS_URL=
LLM_METRICS_TIMEOUT=5

# 监控与告警（非密钥；告警阈值 0 表示关闭）
INFL_MONITOR_WINDOW_HOURS=24
INFL_MONITOR_MAX_CALLS=2000
INFL_ALERT_TTFT_P95_MS=0
INFL_ALERT_RUN_ERROR_RATE=0.2

# P4 评测判据（仅分析任务；0 表示"不得劣化"，max_error_rate=1 表示不限制）
INFL_EVAL_ENABLED=true
INFL_EVAL_MIN_THROUGHPUT_PCT=0
INFL_EVAL_MIN_TTFT_REDUCTION_PCT=0
INFL_EVAL_MAX_ERROR_RATE=1.0
# 相对基线允许的收益下滑容忍度（百分点）
INFL_EVAL_REGRESSION_TOLERANCE_PCT=5

# 运行参数（非密钥）
INFL_API_HOST=127.0.0.1
INFL_API_PORT=8010
INFL_DATA_DIR=./var
INFL_MAX_UPLOAD_MB=20
INFL_QUEUE_SIZE=4
# 并行：worker 总数 + 按资源类的并发闸门
# analysis 占 GPU（默认 1，保证 benchmark 串行独占）；research/validation 走 CPU
INFL_WORKERS=3
INFL_GPU_CONCURRENCY=1
INFL_CPU_CONCURRENCY=2
INFL_VALIDATION_TIMEOUT_S=300
INFL_MIN_GROUP_SAMPLES=2
INFL_CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
